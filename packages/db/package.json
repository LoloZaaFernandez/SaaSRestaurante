{
  "name": "@saasrestaurante/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate:up": "node-pg-migrate up -f migrate.config.ts -m migrations -j ts",
    "migrate:down": "node-pg-migrate down -f migrate.config.ts -m migrations -j ts",
    "seed": "tsx src/seed.ts",
    "rls:apply": "tsx src/rls.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "pg": "^8.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}